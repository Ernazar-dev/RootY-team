# Nusxa oling: .env  (PowerShell: Copy-Item .env.example .env)
# .env GitHub'ga chiqmaydi — parollarni faqat o'sha yerga yozing.

# Saytning manzili, oxirida / belgisisiz.
SITE_URL=http://localhost:3000

# PostgreSQL ulanishi (ma'lumotlar bazasi bosqichidan kerak bo'ladi).
# Lokal:  postgresql://postgres:PAROL@localhost:5432/rooty
# Server: Neon bergan manzil, oxirida ?sslmode=require
DATABASE_URL=
# Ixtiyoriy, faqat Neon uchun: pooler'siz (direct) manzil. Migratsiyalar
# shu orqali ishlaydi; bo'sh bo'lsa DATABASE_URL ishlatiladi.
DATABASE_URL_UNPOOLED=

# Admin hisob. Server har ishga tushganda (npm run dev / npm start) shu
# login bilan admin yaratiladi yoki paroli shu qiymatga yangilanadi.
# Login: lotin harflari, raqamlar, . _ -   Parol: kamida 12 belgi tavsiya.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Ixtiyoriy: admin panelda ko'rinadigan ism.
ADMIN_NAME=
